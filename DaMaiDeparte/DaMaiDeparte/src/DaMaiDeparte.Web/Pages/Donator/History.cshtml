@page
@model DaMaiDeparte.Web.Pages.Donator.HistoryModel
@{
    ViewData["Title"] = "Istoricul donațiilor";
}

<h1 class="h3 mb-3">Istoricul donațiilor</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        @if (!Model.ShowCancelled)
        {
            <a class="nav-link active" aria-current="page" asp-page="./History">Finalizate</a>
        }
        else
        {
            <a class="nav-link text-success" asp-page="./History">Finalizate</a>
        }
    </li>
    <li class="nav-item">
        @if (Model.ShowCancelled)
        {
            <a class="nav-link active" aria-current="page" asp-page="./History" asp-route-tab="cancelled">Anulate</a>
        }
        else
        {
            <a class="nav-link text-success" asp-page="./History" asp-route-tab="cancelled">Anulate</a>
        }
    </li>
</ul>

@if (Model.Items.Count == 0)
{
    <partial name="_EmptyState" model="Model.ShowCancelled ? EmptyStates.DonatorNoCancelled : EmptyStates.DonatorNoCompleted" />
}
else if (!Model.ShowCancelled)
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Donații finalizate</caption>
                <thead>
                    <tr>
                        <th scope="col">Produs</th>
                        <th scope="col">Beneficiar</th>
                        <th scope="col">Rezervat la</th>
                        <th scope="col">Finalizat la</th>
                        <th scope="col">Stare</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><a asp-page="/Donator/Donations/Details" asp-route-id="@item.Id">@item.Title</a><div class="small text-muted">@item.CategoryName</div></td>
                            <td>@(item.ReceiverName ?? "—")</td>
                            <td class="text-nowrap">@RoDate.FormatDateTime(item.ReservedAt)</td>
                            <td class="text-nowrap">@RoDate.FormatDateTime(item.CompletedAt)</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Donații anulate</caption>
                <thead>
                    <tr>
                        <th scope="col">Produs</th>
                        <th scope="col">Publicat la</th>
                        <th scope="col">Anulat la</th>
                        <th scope="col">Stare</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><a asp-page="/Donator/Donations/Details" asp-route-id="@item.Id">@item.Title</a><div class="small text-muted">@item.CategoryName</div></td>
                            <td class="text-nowrap">@RoDate.FormatDate(item.CreatedAt)</td>
                            <td class="text-nowrap">@RoDate.FormatDateTime(item.CancelledAt)</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
