@model DaMaiDeparte.Web.Pages.Donator.DonatorItemListModel
<ul class="list-unstyled d-grid gap-3 mb-0">
    @foreach (var item in Model.Items)
    {
        <li class="card">
            <div class="card-body d-flex flex-column flex-md-row gap-3 align-items-md-center">
                <div class="d-flex gap-3 align-items-center flex-grow-1 min-w-0">
                    <partial name="_DonationImage" model='new DonationImageModel(item.ImagePath, item.Title, "donation-thumb")' />
                    <div class="min-w-0">
                        <h3 class="h6 mb-1 text-truncate">
                            <a class="text-decoration-none" asp-page="/Donator/Donations/Details" asp-route-id="@item.Id">@item.Title</a>
                        </h3>
                        <div class="small text-muted">@item.CategoryName · Publicat la @RoDate.FormatDate(item.CreatedAt)</div>
                        <div class="mt-1 d-flex flex-wrap gap-2 align-items-center">
                            <partial name="_StatusBadge" model="item.Status" />
                            @if (item.Status == DonationStatus.Reserved && item.ReceiverFirstName is not null)
                            {
                                <span class="small">Beneficiar: @item.ReceiverFirstName</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Donator/Donations/Details" asp-route-id="@item.Id">Vezi</a>
                    @if (item.Status == DonationStatus.Available)
                    {
                        <a class="btn btn-sm btn-outline-success" asp-page="/Donator/Donations/Edit" asp-route-id="@item.Id">Editează</a>
                        <form method="post" asp-page="/Donator/Donations/Details" asp-page-handler="Cancel" asp-route-id="@item.Id" asp-route-returnUrl="@Model.ReturnUrl"
                              data-confirm="@UiText.Confirm.CancelDonation" data-confirm-button="@UiText.Confirm.CancelDonationButton" data-cancel-button="@UiText.Confirm.Back">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Anulează donația</button>
                        </form>
                    }
                    else if (item.Status == DonationStatus.Reserved && item.ActiveReservationId.HasValue)
                    {
                        <a class="btn btn-sm btn-outline-success" asp-page="/Donator/Reservations/Details" asp-route-id="@item.ActiveReservationId">Detalii rezervare</a>
                        <form method="post" asp-page="/Donator/Donations/Details" asp-page-handler="Complete" asp-route-id="@item.Id" asp-route-returnUrl="@Model.ReturnUrl"
                              data-confirm="@UiText.Confirm.CompleteDonation" data-confirm-button="@UiText.Confirm.CompleteDonationButton"
                              data-cancel-button="@UiText.Confirm.Back" data-confirm-variant="success">
                            <button type="submit" class="btn btn-sm btn-success">Confirmă predarea</button>
                        </form>
                    }
                </div>
            </div>
        </li>
    }
</ul>
