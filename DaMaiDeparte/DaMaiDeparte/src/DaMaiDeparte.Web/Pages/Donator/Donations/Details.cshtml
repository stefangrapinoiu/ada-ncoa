@page "{id:int}"
@model DaMaiDeparte.Web.Pages.Donator.Donations.DetailsModel
@{
    var d = Model.Donation;
    ViewData["Title"] = d.Title;
    var reservation = Model.ActiveReservation;
}

<a class="d-inline-block mb-3" asp-page="/Donator/Dashboard">
    <i class="bi bi-arrow-left" aria-hidden="true"></i> Înapoi la panoul meu
</a>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <partial name="_DonationImage" model='new DonationImageModel(d.ImagePath, d.Title, "donation-detail-img")' />
    </div>
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
            <h1 class="h3 mb-0">@d.Title</h1>
            <partial name="_StatusBadge" model="d.Status" />
        </div>

        <dl class="donation-meta mb-4">
            <div><dt>Categorie</dt><dd>@d.Category.Name</dd></div>
            <div><dt>Stare</dt><dd>@d.Condition.ToLabel()</dd></div>
            <div><dt>Zonă de predare</dt><dd>@d.PickupArea</dd></div>
            <div><dt>Publicat la</dt><dd>@RoDate.FormatDateTime(d.CreatedAt)</dd></div>
            @if (d.UpdatedAt.HasValue && d.Status == DonationStatus.Available)
            {
                <div><dt>Actualizat la</dt><dd>@RoDate.FormatDateTime(d.UpdatedAt)</dd></div>
            }
            @if (d.CompletedAt.HasValue)
            {
                <div><dt>Finalizat la</dt><dd>@RoDate.FormatDateTime(d.CompletedAt)</dd></div>
            }
            @if (d.CancelledAt.HasValue)
            {
                <div><dt>Anulat la</dt><dd>@RoDate.FormatDateTime(d.CancelledAt)</dd></div>
            }
        </dl>

        <h2 class="h6">Descriere</h2>
        <p class="text-break" style="white-space: pre-line;">@d.Description</p>

        @if (d.Status == DonationStatus.Available)
        {
            <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                <a class="btn btn-success" asp-page="./Edit" asp-route-id="@d.Id">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Editează
                </a>
                <a class="btn btn-outline-success" asp-page="/Donations/Details" asp-route-id="@d.Id">
                    <i class="bi bi-eye" aria-hidden="true"></i> Vezi pagina publică
                </a>
                <form method="post" asp-page-handler="Cancel" asp-route-id="@d.Id"
                      data-confirm="@UiText.Confirm.CancelDonation" data-confirm-button="@UiText.Confirm.CancelDonationButton" data-cancel-button="@UiText.Confirm.Back">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-x-circle" aria-hidden="true"></i> Anulează donația
                    </button>
                </form>
            </div>
        }
        else if (d.Status == DonationStatus.Reserved && reservation is not null)
        {
            <div class="card bg-light mt-4">
                <div class="card-body">
                    <h2 class="h5">Produs rezervat</h2>
                    <p class="mb-3">
                        Rezervat de <strong>@reservation.Receiver.FirstName</strong> la @RoDate.FormatDateTime(reservation.ReservedAt).
                        @if (reservation.MeetingAt.HasValue)
                        {
                            <br /><span>Predare stabilită: @reservation.MeetingLocation, @RoDate.FormatDateTime(reservation.MeetingAt)</span>
                        }
                        else
                        {
                            <br /><span class="text-muted">Detaliile predării nu au fost stabilite încă.</span>
                        }
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <a class="btn btn-success" asp-page="/Donator/Reservations/Details" asp-route-id="@reservation.Id">
                            <i class="bi bi-calendar-event" aria-hidden="true"></i> Detalii rezervare
                        </a>
                        <form method="post" asp-page-handler="Complete" asp-route-id="@d.Id"
                              data-confirm="@UiText.Confirm.CompleteDonation" data-confirm-button="@UiText.Confirm.CompleteDonationButton"
                              data-cancel-button="@UiText.Confirm.Back" data-confirm-variant="success">
                            <button type="submit" class="btn btn-outline-success w-100">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i> Confirmă predarea
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else if (d.Status == DonationStatus.Completed)
        {
            <div class="alert alert-success mt-4" role="status">
                Donație finalizată@(reservation is not null ? $" – predată lui {reservation.Receiver.FirstName} {reservation.Receiver.LastName}" : string.Empty).
            </div>
        }
        else if (d.Status == DonationStatus.Cancelled)
        {
            <div class="alert alert-secondary mt-4" role="status">Această donație a fost anulată și nu mai apare în lista publică.</div>
        }
    </div>
</div>
