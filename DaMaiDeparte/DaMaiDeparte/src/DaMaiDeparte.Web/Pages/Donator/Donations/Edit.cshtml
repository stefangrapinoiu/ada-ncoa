@page "{id:int}"
@model DaMaiDeparte.Web.Pages.Donator.Donations.EditModel
@{
    ViewData["Title"] = "Editează produsul";
}

<div class="form-card">
    <a class="d-inline-block mb-3" asp-page="./Details" asp-route-id="@Model.Id">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Înapoi la produs
    </a>
    <h1 class="h3 mb-4">Editează produsul</h1>

    <div class="card">
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" novalidate>
                <partial name="_DonationFormFields" model="new DonationFormViewModel { Input = Model.Input, Categories = Model.Categories, Conditions = Model.Conditions, CurrentImagePath = Model.CurrentImagePath }" />
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Salvează modificările</button>
                    <a class="btn btn-outline-secondary btn-lg" asp-page="./Details" asp-route-id="@Model.Id">Renunță</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
