@page "{id:int}"
@model DaMaiDeparte.Web.Pages.Receiver.Reservations.DetailsModel
@{
    ViewData["Title"] = "Detalii rezervare";
    var r = Model.Reservation;
    var d = r.DonationItem;
}

<a class="d-inline-block mb-3" asp-page="/Receiver/Dashboard">
    <i class="bi bi-arrow-left" aria-hidden="true"></i> Înapoi la rezervările mele
</a>

<h1 class="h3 mb-4">Detalii rezervare</h1>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <partial name="_DonationImage" model='new DonationImageModel(d.ImagePath, d.Title, "donation-detail-img")' />
    </div>
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <div class="small text-muted">Produs</div>
                        <h2 class="h4 mb-0">@d.Title</h2>
                    </div>
                    @if (r.CancelledAt.HasValue)
                    {
                        <span class="badge rounded-pill text-bg-secondary">Anulată</span>
                    }
                    else
                    {
                        <partial name="_StatusBadge" model="d.Status" />
                    }
                </div>

                <dl class="donation-meta">
                    <div><dt>Categorie</dt><dd>@d.Category.Name</dd></div>
                    <div><dt>Stare</dt><dd>@d.Condition.ToLabel()</dd></div>
                    <div><dt>Zonă de predare</dt><dd>@d.PickupArea</dd></div>
                    <div><dt>Donator</dt><dd>@d.Donator.FirstName @d.Donator.LastName</dd></div>
                    @if (r.CancelledAt is null)
                    {
                        <div><dt>Telefon</dt><dd>@(string.IsNullOrEmpty(d.Donator.PhoneNumber) ? "—" : d.Donator.PhoneNumber)</dd></div>
                        <div><dt>E-mail</dt><dd class="text-break">@d.Donator.Email</dd></div>
                    }
                    <div><dt>Data rezervării</dt><dd>@RoDate.FormatDateTime(r.ReservedAt)</dd></div>
                    @if (Model.IsCompleted)
                    {
                        <div><dt>Primit la</dt><dd>@RoDate.FormatDateTime(d.CompletedAt)</dd></div>
                    }
                    @if (r.CancelledAt.HasValue)
                    {
                        <div><dt>Anulată la</dt><dd>@RoDate.FormatDateTime(r.CancelledAt)</dd></div>
                    }
                </dl>

                <h3 class="h5 mt-4">Predare</h3>
                @if (r.MeetingAt.HasValue)
                {
                    <dl class="donation-meta">
                        <div><dt>Locul predării</dt><dd>@r.MeetingLocation</dd></div>
                        <div><dt>Data și ora predării</dt><dd>@RoDate.FormatDateTime(r.MeetingAt)</dd></div>
                        <div><dt>Instrucțiuni</dt><dd>@(r.Notes ?? "—")</dd></div>
                    </dl>
                }
                else
                {
                    <p class="text-muted">Detaliile pentru predare nu au fost stabilite încă.</p>
                }

                <h3 class="h6 mt-3">Descriere</h3>
                <p class="text-break" style="white-space: pre-line;">@d.Description</p>

                @if (Model.IsActive)
                {
                    <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" class="mt-3"
                          data-confirm="@UiText.Confirm.CancelReservation" data-confirm-button="@UiText.Confirm.CancelReservationButton" data-cancel-button="@UiText.Confirm.Back">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-x-circle" aria-hidden="true"></i> Anulează rezervarea
                        </button>
                    </form>
                }
                else if (Model.IsCompleted)
                {
                    <div class="alert alert-success mt-3 mb-0" role="status">Donație finalizată. Bucură-te de noul tău produs!</div>
                }
            </div>
        </div>
    </div>
</div>
