@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acces interzis";
}

<div class="text-center py-5">
    <i class="bi bi-shield-lock display-3 text-success" aria-hidden="true"></i>
    <h1 class="h2 mt-3">Nu ai acces la această pagină</h1>
    <p class="text-muted">Nu ai permisiunea necesară pentru a accesa această resursă.</p>
    <a class="btn btn-success" asp-page="/Index" asp-area="">Înapoi la pagina principală</a>
</div>
