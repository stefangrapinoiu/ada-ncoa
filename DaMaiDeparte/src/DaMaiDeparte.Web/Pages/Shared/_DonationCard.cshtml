@model DonationCard
<article class="card h-100 donation-card">
    <partial name="_DonationImage" model='new DonationImageModel(Model.ImagePath, Model.Title, "card-img-top donation-card-img")' />
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h2 class="h5 card-title mb-0">@Model.Title</h2>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>

        <p class="mb-2">
            <span class="badge @Model.ExpirationDate.ToExpiryClass()">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                Expiră: @RoDate.FormatDate(Model.ExpirationDate)
            </span>
        </p>

        <dl class="small mb-3 donation-meta">
            <div><dt>Categorie</dt><dd>@Model.CategoryName</dd></div>
            <div><dt>Locație</dt><dd>@DisplayExtensions.ToLocationLabel(Model.CityName, Model.NeighborhoodName)</dd></div>
            <div><dt>Predare</dt><dd>@Model.PickupLocation</dd></div>
            <div><dt>Publicat</dt><dd>@RoDate.FormatDate(Model.CreatedAt)</dd></div>
        </dl>

        @if (Model.IsOwn)
        {
            <p class="small text-muted mb-2"><i class="bi bi-person-check" aria-hidden="true"></i> Donația ta</p>
        }

        <a class="btn btn-outline-success mt-auto stretched-link" asp-page="/Donations/Details" asp-route-id="@Model.Id">
            Vezi detalii<span class="visually-hidden">: @Model.Title</span>
        </a>
    </div>
</article>
