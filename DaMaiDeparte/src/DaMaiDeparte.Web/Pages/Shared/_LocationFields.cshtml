@model LocationPickerModel
@{
    var countryId = LocationPickerModel.IdFor(Model.CountryField);
    var cityId = LocationPickerModel.IdFor(Model.CityField);
    var neighborhoodId = LocationPickerModel.IdFor(Model.NeighborhoodField);
    var columnClass = Model.Inline ? "col-12 col-md-4" : "col-12";
    var selectedCountry = Model.CountryId ?? (Model.Countries.Count == 1 ? Model.Countries[0].Id : null);
}

<div class="row g-3" data-location-picker>
    <div class="@columnClass">
        <label for="@countryId" class="form-label">@UiText.Location.Country</label>
        <select id="@countryId" name="@Model.CountryField" class="form-select" data-location-country required>
            @if (Model.Countries.Count != 1)
            {
                <option value="">Alege țara</option>
            }
            @foreach (var country in Model.Countries)
            {
                <option value="@country.Id" selected="@(country.Id == selectedCountry)">@country.Name</option>
            }
        </select>
        @Html.ValidationMessage(Model.CountryField, new { @class = "small text-danger d-block" })
    </div>

    <div class="@columnClass">
        <label for="@cityId" class="form-label">@UiText.Location.City</label>
        <select id="@cityId" name="@Model.CityField" class="form-select" data-location-city required>
            <option value="">Alege orașul</option>
            @foreach (var city in Model.Cities)
            {
                <option value="@city.Id" data-country="@city.CountryId" selected="@(city.Id == Model.CityId)">@city.Name</option>
            }
        </select>
        @Html.ValidationMessage(Model.CityField, new { @class = "small text-danger d-block" })
    </div>

    <div class="@columnClass">
        <label for="@neighborhoodId" class="form-label">@UiText.Location.Neighborhood</label>
        <select id="@neighborhoodId" name="@Model.NeighborhoodField" class="form-select" data-location-neighborhood>
            <option value="">@Model.NeighborhoodEmptyLabel</option>
            @foreach (var neighborhood in Model.Neighborhoods)
            {
                <option value="@neighborhood.Id" data-city="@neighborhood.CityId" selected="@(neighborhood.Id == Model.NeighborhoodId)">@neighborhood.Name</option>
            }
        </select>
        @if (Model.ShowNeighborhoodHelp)
        {
            <div class="form-text">@UiText.Location.NeighborhoodHelp</div>
        }
        @Html.ValidationMessage(Model.NeighborhoodField, new { @class = "small text-danger d-block" })
    </div>
</div>
