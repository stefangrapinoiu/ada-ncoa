@page
@model RegisterModel
@{
    ViewData["Title"] = "Creează un cont";
}

<div class="card auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-2">Creează un cont</h1>
        <p class="text-muted mb-4">
            Cu un singur cont poți oferi alimente și poți rezerva alimente oferite de alții.
        </p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-12 col-sm-6">
                    <label asp-for="Input.FirstName" class="form-label"></label>
                    <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="Input.FirstName" class="small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Input.LastName" class="form-label"></label>
                    <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="Input.LastName" class="small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="nume@exemplu.ro" />
                    <span asp-validation-for="Input.Email" class="small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.PhoneNumber" class="form-label"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" placeholder="Ex: 0722 123 456" />
                    <div class="form-text">Nu este afișat niciodată altor utilizatori — coordonezi predarea prin mesajele din aplicație.</div>
                    <span asp-validation-for="Input.PhoneNumber" class="small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                    <span asp-validation-for="Input.Password" class="small"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="small"></span>
                </div>
                <div class="col-12">
                    <div id="passwordHelp" class="form-text">Cel puțin 8 caractere, cu o literă mare, o literă mică și o cifră.</div>
                </div>
            </div>

            <fieldset class="mt-4">
                <legend class="h6 mb-3">Unde te afli?</legend>
                <partial name="_LocationFields" model="Model.Picker" />
            </fieldset>

            <div class="form-check mt-4">
                <input asp-for="Input.GdprConsent" class="form-check-input" />
                <label asp-for="Input.GdprConsent" class="form-check-label">
                    Sunt de acord cu prelucrarea datelor mele personale, conform
                    <a asp-page="/Legal/Termeni" target="_blank" rel="noopener">Termenilor și Condițiilor</a>.
                </label>
                <div><span asp-validation-for="Input.GdprConsent" class="small"></span></div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 mt-4">Creează cont</button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Ai deja un cont? Autentifică-te</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
