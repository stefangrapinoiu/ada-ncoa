@page
@model LoginModel
@{
    ViewData["Title"] = "Autentificare";
}

<div class="card auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-4">Autentificare</h1>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Email" class="small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="small"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label"></label>
                </div>
                <a asp-page="./ForgotPassword">Ai uitat parola?</a>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100">Autentifică-te</button>
        </form>

        <p class="text-center mt-4 mb-0">
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Nu ai încă un cont? Creează unul</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
