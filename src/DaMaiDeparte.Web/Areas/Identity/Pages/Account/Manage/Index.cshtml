@page
@model IndexModel
@{
    ViewData["Title"] = "Contul meu";
}

<div class="form-card">
    <h1 class="h3 mb-4">Profil</h1>

    <div class="card mb-3">
        <div class="card-body p-4 d-flex flex-row gap-3 align-items-center">
            <span class="icon-circle icon-circle-neutral flex-shrink-0" aria-hidden="true">
                <i class="bi bi-person-fill"></i>
            </span>
            <div class="min-w-0">
                <div class="fw-bold text-truncate" style="font-size:1.1rem;color:var(--dmd-ink);">@Model.Email</div>
                <div class="small" style="color:var(--dmd-ink-soft);">Membru din @RoDate.FormatDate(Model.CreatedAt)</div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-page="/Location" asp-area="">
                <i class="bi bi-geo-alt text-success" aria-hidden="true"></i>
                <span class="flex-grow-1">@UiText.Location.MyLocation</span>
                <span class="small text-truncate" style="max-width:140px;color:var(--dmd-ink-faint);">@(Model.PreferredLocation ?? "Nesetată")</span>
                <i class="bi bi-chevron-right" style="color:var(--dmd-ink-faint);" aria-hidden="true"></i>
            </a>
            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" asp-page="./ChangePassword">
                <i class="bi bi-shield-lock text-success" aria-hidden="true"></i>
                <span class="flex-grow-1">Parolă</span>
                <i class="bi bi-chevron-right" style="color:var(--dmd-ink-faint);" aria-hidden="true"></i>
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Date personale</h2>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="Input.FirstName" class="small"></span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label asp-for="Input.LastName" class="form-label"></label>
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="Input.LastName" class="small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Input.PhoneNumber" class="small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-success mt-4">Salvează modificările</button>
            </form>
        </div>
    </div>

    <form method="post" asp-area="Identity" asp-page="/Account/Logout">
        <button type="submit" class="btn btn-logout">
            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Deconectare
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
