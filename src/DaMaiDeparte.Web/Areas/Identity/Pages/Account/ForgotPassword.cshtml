@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Ai uitat parola?";
}

<div class="card auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-3">Ai uitat parola?</h1>

        @if (Model.Submitted)
        {
            <div class="alert alert-info" role="status">
                Dacă adresa introdusă este asociată unui cont, am trimis un e-mail cu un link pentru
                resetarea parolei. Verifică și folderul de spam.
            </div>
            @if (Model.DevResetLink is not null)
            {
                <div class="alert alert-warning" role="status">
                    <strong>Mod dezvoltare:</strong> nu este configurat un server de e-mail, așa că
                    linkul de resetare este afișat direct aici:<br />
                    <a href="@Model.DevResetLink" class="text-break">@Model.DevResetLink</a>
                </div>
            }
            <a class="btn btn-success" asp-page="./Login">Înapoi la autentificare</a>
        }
        else
        {
            <p class="text-muted">Introdu adresa de e-mail folosită la crearea contului.</p>
            <form method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Trimite</button>
            </form>
            <p class="text-center mt-4 mb-0"><a asp-page="./Login">Înapoi la autentificare</a></p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
