@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Resetează parola";
}

<div class="card auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-3">Resetează parola</h1>

        @if (Model.LinkInvalid)
        {
            <div class="alert alert-danger" role="alert">
                Acest link de resetare este invalid sau a expirat.
            </div>
            <a class="btn btn-success" asp-page="./ForgotPassword">Cere un link nou</a>
        }
        else if (Model.Submitted)
        {
            <div class="alert alert-success" role="status">
                Parola a fost schimbată. Te poți autentifica acum cu noua parolă.
            </div>
            <a class="btn btn-success" asp-page="./Login">Autentifică-te</a>
        }
        else
        {
            <p class="text-muted">Alege o parolă nouă pentru contul tău.</p>
            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Input.Email" />
                <input type="hidden" asp-for="Input.Code" />
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label"></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-describedby="newPasswordHelp" />
                    <div id="newPasswordHelp" class="form-text">Cel puțin 8 caractere, cu o literă mare, o literă mică și o cifră.</div>
                    <span asp-validation-for="Input.NewPassword" class="small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="small"></span>
                </div>
                <button type="submit" class="btn btn-success w-100">Schimbă parola</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
