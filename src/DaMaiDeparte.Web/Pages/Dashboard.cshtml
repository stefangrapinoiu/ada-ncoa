@page
@model DaMaiDeparte.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Anunțuri disponibile";
    var results = Model.Results;
    var tabs = new (FeedFilter Filter, string Label)[]
    {
        (FeedFilter.All, "Toate"),
        (FeedFilter.Available, "Disponibile"),
        (FeedFilter.Reserved, "Rezervate")
    };
}

<partial name="_LocationBar" model='new LocationBarModel(Model.Location, Url.Page("/Dashboard"))' />

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Anunțuri disponibile</h1>
        <p class="text-muted mb-0">Descoperă alimente oferite în apropierea ta.</p>
    </div>
    <a class="btn btn-success btn-lg" asp-page="/Donations/Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Adaugă un aliment
    </a>
</div>

<form method="get" class="card mb-4" role="search" aria-label="Filtrează alimentele">
    <div class="card-body">
        <input type="hidden" name="p" value="1" />
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-5">
                <label for="q" class="form-label">Caută</label>
                <div class="search-field">
                    <input type="search" id="q" name="q" value="@Model.Search" class="form-control"
                           placeholder="Ex: pâine, paste, suc..." maxlength="100" />
                    <button type="submit" class="search-field-btn" aria-label="Caută">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <label for="cartier" class="form-label">Cartier</label>
                <select id="cartier" name="cartier" class="form-select" data-autosubmit
                        disabled="@(Model.Neighborhoods.Count == 0)">
                    <option value="">@UiText.Location.AllNeighborhoods</option>
                    @foreach (var neighborhood in Model.Neighborhoods)
                    {
                        <option value="@neighborhood.Id" selected="@(neighborhood.Id == Model.NeighborhoodId)">@neighborhood.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="categorie" class="form-label">Categorie</label>
                <select id="categorie" name="categorie" class="form-select" data-autosubmit>
                    <option value="">Toate categoriile</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                    }
                </select>
            </div>
        </div>

        <nav class="mt-3" aria-label="Filtrează după stare">
            <div class="segmented flex-nowrap overflow-auto">
                @foreach (var tab in tabs)
                {
                    var route = Model.RouteFor(1);
                    route.Remove("stare");
                    if (tab.Filter != FeedFilter.All)
                    {
                        route["stare"] = tab.Filter.ToString();
                    }

                    if (tab.Filter == Model.Filter)
                    {
                        <a class="nav-link text-nowrap active" aria-current="page"
                           asp-page="/Dashboard" asp-all-route-data="route">@tab.Label</a>
                    }
                    else
                    {
                        <a class="nav-link text-nowrap"
                           asp-page="/Dashboard" asp-all-route-data="route">@tab.Label</a>
                    }
                }
            </div>
        </nav>

        @if (Model.HasFilters)
        {
            <a class="btn-chip mt-3" asp-page="/Dashboard"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Resetează filtrele</a>
        }
    </div>
</form>

@if (results.TotalCount == 0)
{
    <partial name="_EmptyState" model="@(Model.HasFilters ? EmptyStates.NoFoodForFilters : EmptyStates.NoFoodInCity)" />
}
else
{
    <p class="text-muted" role="status">Rezultate: <strong>@results.TotalCount</strong></p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var item in results.Items)
        {
            <div class="col"><partial name="_DonationCard" model="item" /></div>
        }
    </div>

    @if (results.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Paginare rezultate">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(results.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-page="/Dashboard" asp-all-route-data="Model.RouteFor(results.Page - 1)">
                        <span aria-hidden="true">&laquo;</span> Anterioara
                    </a>
                </li>
                @for (var i = Math.Max(1, results.Page - 2); i <= Math.Min(results.TotalPages, results.Page + 2); i++)
                {
                    if (i == results.Page)
                    {
                        <li class="page-item active" aria-current="page"><span class="page-link">@i</span></li>
                    }
                    else
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="/Dashboard" asp-all-route-data="Model.RouteFor(i)" aria-label="Pagina @i">@i</a>
                        </li>
                    }
                }
                <li class="page-item @(results.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-page="/Dashboard" asp-all-route-data="Model.RouteFor(results.Page + 1)">
                        Următoarea <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
