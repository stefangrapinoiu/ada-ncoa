@page
@model DaMaiDeparte.Web.Pages.Legal.AcceptareTermeniModel
@{
    ViewData["Title"] = "Termeni și Condiții";
}

<div class="card auth-card">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-2">Înainte să continui</h1>
        <p class="text-muted mb-4">
            Am actualizat Termenii și Condițiile. Te rugăm să le citești și să confirmi că ești
            de acord, pentru a putea folosi în continuare Ada-nCoa.
        </p>

        <div class="legal-scroll border rounded p-3 mb-4" style="max-height: 320px; overflow-y: auto;">
            <partial name="_LegalContent" />
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <button type="submit" class="btn btn-success btn-lg w-100">Sunt de acord, continuă</button>
        </form>

        <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="mt-2">
            <button type="submit" class="btn btn-link w-100">Nu sunt de acord — Deconectare</button>
        </form>
    </div>
</div>
