@page
@model DaMaiDeparte.Web.Pages.Donator.DashboardModel
@{
    ViewData["Title"] = "Panoul meu de donator";
    var data = Model.Data;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Panoul meu de donator</h1>
        <p class="text-muted mb-0">Bine ai revenit, @data.FirstName!</p>
    </div>
    <a class="btn btn-success btn-lg" asp-page="/Donator/Donations/Create">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Adaugă un produs
    </a>
</div>

<div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
    <div class="col">
        <a class="card summary-card h-100 text-decoration-none text-body" asp-page="/Donator/Donations/Index" asp-route-status="@DonationStatus.Available">
            <div class="card-body">
                <div class="display-6">@data.AvailableCount</div>
                <div class="text-muted">Produse disponibile</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="card summary-card h-100 text-decoration-none text-body" asp-page="/Donator/Donations/Index" asp-route-status="@DonationStatus.Reserved">
            <div class="card-body">
                <div class="display-6">@data.ReservedCount</div>
                <div class="text-muted">Produse rezervate</div>
            </div>
        </a>
    </div>
    <div class="col">
        <a class="card summary-card h-100 text-decoration-none text-body" asp-page="/Donator/History">
            <div class="card-body">
                <div class="display-6">@data.CompletedCount</div>
                <div class="text-muted">Donații finalizate</div>
            </div>
        </a>
    </div>
</div>

<h2 class="h4 mb-3">Produsele mele active</h2>

@if (data.ActiveItems.Count == 0)
{
    <partial name="_EmptyState" model="EmptyStates.DonatorNoProducts" />
}
else
{
    <partial name="/Pages/Donator/_DonatorItemList.cshtml" model='new DonatorItemListModel(data.ActiveItems, Url.Page("/Donator/Dashboard"))' />
}
