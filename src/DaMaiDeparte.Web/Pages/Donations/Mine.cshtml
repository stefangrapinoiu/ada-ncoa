@page
@model DaMaiDeparte.Web.Pages.Donations.MineModel
@{
    ViewData["Title"] = "Donațiile mele";
    var tabs = new (DonationStatus? Status, string Label)[]
    {
        (null, "Active"),
        (DonationStatus.Available, UiText.Status.Available + "e"),
        (DonationStatus.Reserved, UiText.Status.Reserved + "e"),
        (DonationStatus.Completed, "Donate"),
        (DonationStatus.Expired, "Expirate"),
        (DonationStatus.Cancelled, "Anulate")
    };
    var returnUrl = Url.Page("/Donations/Mine", new { stare = Model.Status?.ToString() });
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Donațiile mele</h1>
        <p class="text-muted mb-0">Bine ai revenit, @Model.Summary.FirstName!</p>
    </div>
    <a class="btn btn-success" asp-page="./Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Adaugă un aliment</a>
</div>

<div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
    <div class="col">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="display-6">@Model.Summary.AvailableCount</div>
                <div class="text-muted">Alimente disponibile</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="display-6">@Model.Summary.ReservedCount</div>
                <div class="text-muted">Alimente rezervate</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card summary-card h-100">
            <div class="card-body">
                <div class="display-6">@Model.Summary.CompletedCount</div>
                <div class="text-muted">Donații finalizate</div>
            </div>
        </div>
    </div>
</div>

<nav aria-label="Filtrează după stare" class="mb-3">
    <ul class="nav nav-pills flex-nowrap overflow-auto">
        @foreach (var tab in tabs)
        {
            var active = tab.Status == Model.Status;
            <li class="nav-item">
                @if (active)
                {
                    <a class="nav-link text-nowrap active bg-success" aria-current="page"
                       asp-page="./Mine" asp-route-stare="@tab.Status?.ToString()">@tab.Label</a>
                }
                else
                {
                    <a class="nav-link text-nowrap text-success"
                       asp-page="./Mine" asp-route-stare="@tab.Status?.ToString()">@tab.Label</a>
                }
            </li>
        }
    </ul>
</nav>

@if (Model.Items.Count == 0)
{
    <partial name="_EmptyState" model="@(Model.Status.HasValue ? EmptyStates.NoDonationsInSection : EmptyStates.NoDonationsYet)" />
}
else
{
    <ul class="list-unstyled d-grid gap-3 mb-0">
        @foreach (var item in Model.Items)
        {
            <li class="card">
                <div class="card-body d-flex flex-column flex-md-row gap-3 align-items-md-center">
                    <div class="d-flex gap-3 align-items-center flex-grow-1 min-w-0">
                        <partial name="_DonationImage" model='new DonationImageModel(item.ImagePath, item.Title, "donation-thumb")' />
                        <div class="min-w-0">
                            <h2 class="h6 mb-1 text-truncate">
                                <a class="text-decoration-none" asp-page="./Details" asp-route-id="@item.Id">@item.Title</a>
                            </h2>
                            <div class="small text-muted">
                                @item.CategoryName · @DisplayExtensions.ToLocationLabel(item.CityName, item.NeighborhoodName)
                            </div>
                            <div class="small text-muted"><i class="bi bi-geo-alt" aria-hidden="true"></i> @item.PickupLocation</div>
                            <div class="mt-1 d-flex flex-wrap gap-2 align-items-center">
                                <partial name="_StatusBadge" model="item.Status" />
                                <span class="badge @item.ExpirationDate.ToExpiryClass()">
                                    Expiră: @RoDate.FormatDate(item.ExpirationDate)
                                </span>
                                @if (item.Status == DonationStatus.Reserved && item.ReceiverFirstName is not null)
                                {
                                    <span class="small">Rezervat de: @item.ReceiverFirstName</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-id="@item.Id">Vezi</a>
                        @if (item.Status == DonationStatus.Available)
                        {
                            <a class="btn btn-sm btn-outline-success" asp-page="./Edit" asp-route-id="@item.Id">Editează</a>
                            <form method="post" asp-page="./Details" asp-page-handler="Cancel" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl"
                                  data-confirm="@UiText.Confirm.CancelDonation" data-confirm-button="@UiText.Confirm.CancelDonationButton"
                                  data-cancel-button="@UiText.Confirm.Back">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Anulează</button>
                            </form>
                        }
                        else if (item.Status == DonationStatus.Reserved && item.ActiveReservationId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-success" asp-page="/Reservations/Details" asp-route-id="@item.ActiveReservationId">Detalii rezervare</a>
                            <form method="post" asp-page="./Details" asp-page-handler="Complete" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl"
                                  data-confirm="@UiText.Confirm.CompleteDonation" data-confirm-button="@UiText.Confirm.CompleteDonationButton"
                                  data-cancel-button="@UiText.Confirm.Back" data-confirm-variant="success">
                                <button type="submit" class="btn btn-sm btn-success">Confirmă predarea</button>
                            </form>
                        }
                    </div>
                </div>
            </li>
        }
    </ul>
}
