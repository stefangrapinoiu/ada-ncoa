@page
@model DaMaiDeparte.Web.Pages.Donations.CreateModel
@{
    ViewData["Title"] = "Adaugă un aliment";
}

<div class="wizard-shell" data-wizard>
    <div class="wizard-header">
        <a class="wizard-close" asp-page="/Dashboard" aria-label="Renunță">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </a>
        <h1 class="h5">Adaugă un aliment</h1>
    </div>

    <div class="wizard-progress">
        <div class="wizard-progress-bar">
            <span class="wizard-progress-seg" data-wizard-seg="1"></span>
            <span class="wizard-progress-seg" data-wizard-seg="2"></span>
            <span class="wizard-progress-seg" data-wizard-seg="3"></span>
        </div>
        <p class="wizard-step-label" data-wizard-label>Pasul 1 din 3 · Fotografii</p>
    </div>

    <form method="post" enctype="multipart/form-data" novalidate>
        <partial name="_DonationWizardFields" model="Model.Form" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/donation-wizard.js" asp-append-version="true"></script>
}
