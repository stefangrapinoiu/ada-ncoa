<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string title && title.Length > 0 ? $"{title} – {AppInfo.Name}" : AppInfo.Name)</title>
    <meta name="description" content="@AppInfo.Name – @AppInfo.Tagline Oferă alimentele ambalate pe care nu le vei consuma unei persoane din apropiere." />
    <meta name="theme-color" content="@AppInfo.ThemeColor" />
    <meta name="application-name" content="@AppInfo.ShortName" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@AppInfo.ShortName" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/images/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "has-bottom-nav" : "")">
    <a class="visually-hidden-focusable skip-link" href="#main-content">Sari la conținut</a>

    <div class="app-scroll" id="appScroll">
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm" aria-label="Navigare principală">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-page="/Index">
                    <span class="brand-leaf" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 64 64" fill="none">
                            <path d="M10 54C10 27 28 11 55 9C55 36 38 53 12 54Z" fill="#047857"></path>
                            <path d="M12 52L41 23" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round"></path>
                            <path d="M24 40L20 30M31 33L29 24M24 40L34 42M31 33L41 34" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" opacity=".85"></path>
                        </svg>
                    </span>
                    <span>Adă<span class="brand-hyphen">-</span>nCoa</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="order-lg-last ms-auto ms-lg-3 me-2 me-lg-0">
                        @await Component.InvokeAsync("UnreadMessagesBell")
                    </div>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Deschide meniul">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Dashboard">Anunțuri</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Donations/Create">Adaugă un aliment</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Donations/Mine">Donațiile mele</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Reservations/Index">Rezervările mele</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Acasă</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item">
                            <button type="button" id="pwaInstallBtn" class="btn btn-outline-success btn-sm d-none ms-lg-2">
                                <i class="bi bi-download" aria-hidden="true"></i> Instalează aplicația
                            </button>
                        </li>
                        <li class="nav-item js-install-help">
                            <a asp-page="/Ajutor/Instalare" class="btn btn-outline-success btn-sm ms-lg-2">
                                <i class="bi bi-phone" aria-hidden="true"></i> Cum instalez aplicația?
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    <i class="bi bi-person-circle" aria-hidden="true"></i> Contul meu
                                </a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">
                                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Deconectare
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Autentificare</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-success" asp-area="Identity" asp-page="/Account/Register">Creează cont</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container py-4" tabindex="-1">
        <partial name="_StatusMessages" />
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 text-muted small">
            <span>&copy; @DateTime.UtcNow.Year @AppInfo.Name – @AppInfo.Tagline</span>
            <span>Doar alimente ambalate, sigilate și în termen.</span>
            <span class="d-flex gap-3">
                <a asp-page="/Ajutor/Instalare" class="text-muted">Cum instalez aplicația?</a>
                <a asp-page="/Legal/Termeni" class="text-muted">Termeni și Condiții</a>
            </span>
        </div>
    </footer>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_BottomNav" />
    }

    <partial name="_ConfirmModal" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/ro.js" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="iosInstallTip" class="alert alert-success d-none fixed-bottom m-3 shadow-sm d-flex align-items-center justify-content-between gap-3" role="status">
        <span>
            Instalează Adă-nCoa pe ecranul principal: apasă
            <i class="bi bi-box-arrow-up" aria-hidden="true"></i> (Distribuie), apoi
            „Adaugă pe ecranul principal”.
        </span>
        <button type="button" id="iosInstallTipClose" class="btn-close" aria-label="Închide"></button>
    </div>
</body>
</html>
