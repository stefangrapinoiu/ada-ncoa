@{
    var success = TempData[TempDataKeys.Success] as string;
    var error = TempData[TempDataKeys.Error] as string;
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-start gap-2" role="status">
        <i class="bi bi-check-circle-fill mt-1" aria-hidden="true"></i>
        <div>@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Închide"></button>
    </div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
        <div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Închide"></button>
    </div>
}
