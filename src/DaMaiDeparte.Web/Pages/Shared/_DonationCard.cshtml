@model DonationCard
<article class="card h-100 donation-card">
    <a asp-page="/Donations/Details" asp-route-id="@Model.Id" class="position-relative d-block text-decoration-none" aria-label="@Model.Title">
        <partial name="_DonationImage" model='new DonationImageModel(Model.ImagePath, Model.Title, "card-img-top donation-card-img")' />
        <span class="position-absolute" style="left:12px;top:12px;">
            <partial name="_StatusBadge" model="Model.Status" />
        </span>
        <span class="position-absolute badge @Model.ExpirationDate.ToExpiryClass()" style="left:12px;bottom:12px;box-shadow:0 2px 8px rgba(11,15,13,.10);">
            <i class="bi bi-calendar-event" aria-hidden="true"></i>
            @RoDate.DescribeRemaining(Model.ExpirationDate)
        </span>
    </a>
    <div class="card-body d-flex flex-column">
        <a asp-page="/Donations/Details" asp-route-id="@Model.Id" class="text-decoration-none">
            <h2 class="h6 fw-bold mb-1" style="color:var(--dmd-ink);">@Model.Title</h2>
        </a>

        <div class="d-flex flex-column mb-3">
            <span class="small fw-semibold" style="color:var(--dmd-ink-soft);">@Model.CategoryName</span>
            <span class="small d-flex align-items-center gap-1" style="color:var(--dmd-ink-faint);">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                @DisplayExtensions.ToLocationLabel(Model.CityName, Model.NeighborhoodName) · @RoDate.FormatDate(Model.CreatedAt)
            </span>
        </div>

        @if (Model.IsOwn)
        {
            <p class="small text-muted mb-2"><i class="bi bi-person-check" aria-hidden="true"></i> Donația ta</p>
        }

        <a class="btn btn-outline-success mt-auto stretched-link" asp-page="/Donations/Details" asp-route-id="@Model.Id">
            Vezi detalii<span class="visually-hidden">: @Model.Title</span>
        </a>
    </div>
</article>
